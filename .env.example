# Copy to .env for local development. Every integration falls back to a mock/log mode when its
# credentials are empty, so the API runs end-to-end with only MONGODB_URI.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated; include the Vercel marketing site origin in production.
CORS_ORIGINS=*

MONGODB_URI=mongodb://127.0.0.1:27017/turnbyturn

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Squadco (payments, payouts, account lookup, SMS OTP) ---
SQUADCO_SECRET_KEY=
SQUADCO_MERCHANT_ID=
# sandbox: https://sandbox-api-d.squadco.com   live: https://api-d.squadco.com
SQUADCO_BASE_URL=https://sandbox-api-d.squadco.com
SQUADCO_SMS_SENDER_ID=TurnByTurn
SQUADCO_PAYMENT_CALLBACK_URL=
# Defaults to true when SQUADCO_SECRET_KEY is empty.
# SQUADCO_MOCK=true

# --- Zeptomail ---
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=noreply@turnbyturn.app
ZEPTOMAIL_FROM_NAME=TurnByTurn

# --- Firebase Cloud Messaging: service-account JSON, raw or base64 ---
FIREBASE_SERVICE_ACCOUNT=

# --- Business rules ---
PLATFORM_FEE_BPS=200
MIN_PARTIAL_PAYMENT_KOBO=10000
CYCLE_OVERDUE_GRACE_HOURS=24
CYCLE_RESOLUTION_AFTER_DAYS=7
AUTO_REMINDER_DAYS_BEFORE=3,1
REMINDER_COOLDOWN_HOURS=24
AUTO_START_PAYOUTS=false

# --- Auth throttling ---
SIGNIN_MAX_FAILURES=5
SIGNIN_WINDOW_SECONDS=900
LOCKOUT_SECONDS=900
OTP_SEND_MAX_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only (ignored in production): every OTP becomes this code.
OTP_DEV_FIXED_CODE=123456

# --- Jobs ---
ENABLE_INPROCESS_JOBS=false
INPROCESS_JOBS_INTERVAL_SECONDS=300
# Enables POST /api/v1/internal/jobs/run with header x-cron-secret
CRON_SECRET=

# Mock checkout + job trigger routes under /api/v1/dev (default: on outside production)
ENABLE_DEV_ROUTES=true
