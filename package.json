{
  "name": "turnbyturn-api",
  "version": "1.0.0",
  "description": "TurnByTurn ROSCA (ajo/esusu) backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "jobs": "node dist/jobs/run.js",
    "jobs:dev": "tsx src/jobs/run.ts",
    "seed": "tsx src/seed/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "docs": "tsx scripts/build-openapi.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turnbyturnttt-wq/Turn-By-Turn.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/turnbyturnttt-wq/Turn-By-Turn/issues"
  },
  "homepage": "https://github.com/turnbyturnttt-wq/Turn-By-Turn#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
